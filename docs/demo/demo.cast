[0.008, "o", "\u001b[1m{\u001b[0m\r\n    \u001b[32m'format'\u001b[0m: \u001b[32m'always a markdown table when comparing numbers, minimal prose around it'\u001b[0m,\r\n    \u001b[32m'depth'\u001b[0m: \u001b[32m'headline plus three supporting bullets, no methodology unless asked'\u001b[0m,\r\n    \u001b[32m'recommendation'\u001b[0m: \u001b[32m'Always finish every answer with a one-line \"so what\" recommendation.'\u001b[0m\r\n\u001b[1m}\u001b[0m\r\n"]
