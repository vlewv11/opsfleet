# ---- LLM ----------------------------------------------------------------
# google (default) | openrouter | ollama
LLM_PROVIDER=google
# Free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only if LLM_PROVIDER=openrouter  (pip install langchain-openai)
OPENROUTER_API_KEY=
# Only if LLM_PROVIDER=ollama      (pip install langchain-ollama)
OLLAMA_BASE_URL=http://localhost:11434

REASONING_MODEL=gemini-2.5-pro
FAST_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# ---- BigQuery -----------------------------------------------------------
# Project billed for queries. Auth comes from ADC:
#   gcloud auth application-default login
GCP_PROJECT=
BQ_LOCATION=US
BQ_DATASET=bigquery-public-data.thelook_ecommerce

# ---- Guardrails ---------------------------------------------------------
MAX_BYTES_BILLED=2000000000
ROW_LIMIT=500
MAX_SQL_REPAIRS=3
MAX_STEPS=12
# Change this. It salts the hash applied to customer identifiers.
PII_SALT=change-me-in-production
